{
  "name": "dsh-xjtlu-library",
  "version": "0.1.6",
  "type": "module",
  "description": "XJTLU 图书馆连接器：让 agent 检索馆藏与论文、经学校代理判断订阅并取全文。",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "mcp",
    "xjtlu",
    "library",
    "opac"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seally-web/xjtlu-library-mcp.git"
  }
}
